generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// --- NextAuth ---

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  // Substack identity captured on first sync via the extension's syncUser().
  // Optional until the user connects.
  substackUserId   Int?
  substackHandle   String?
  substackName     String?
  substackPhotoUrl String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  publications Publication[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- StackTicle domain ---

model Publication {
  id            String    @id @default(cuid())
  userId        String
  substackId    Int       @unique // Substack publication id
  name          String
  subdomain     String
  customDomain  String?
  logoUrl       String?
  isPrimary     Boolean   @default(false)
  paymentsState String? // "enabled" | "disabled"
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([userId])
}

enum PostStatus {
  published
  scheduled
  drafts
}

enum PostType {
  newsletter
  podcast
  restack
}

model Post {
  id            String     @id @default(cuid())
  publicationId String
  substackId    Int // Substack numeric post id
  uuid          String?
  type          PostType   @default(newsletter)
  status        PostStatus
  title         String?
  draftTitle    String?
  postDate      DateTime?
  triggerAt     DateTime?
  coverImage    String?
  bylines       Json? // PostByline[]
  stats         Json? // PostStats
  headlineTest  Json? // HeadlineTest | null
  syncedAt      DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, substackId])
  @@index([publicationId, status, postDate])
}

model SyncLog {
  id            String    @id @default(cuid())
  publicationId String
  status        String // "ok" | "error"
  error         String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
}
